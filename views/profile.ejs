<!DOCTYPE html>
<html lang="en">
   <head>
      <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" integrity="sha512-SzlrxWUlpfuzQ+pcUCosxcglQRNAq/DZjVsC0lE40xsADsfeQoEypE+enwcOiGjk/bSuGGKHEyjSoQ1zVisanQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shards-ui@3.0.0/dist/css/shards.min.css">
      <script src="https://cdn.jsdelivr.net/npm/shards-ui@3.0.0/dist/js/shards.min.js"></script>
      <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="/css/styles.css">
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title> <%= user.full_name %> (@<%= user.username %>) - Profile</title>
      <meta property="og:title" content="<%= user.full_name %> (@<%= user.username %>) - Profile">
      <meta property="og:description" content="View the profile of <%= user.full_name %> (@<%= user.username %>) on our site.">
      <meta property="og:url" content="https://devhauz.truanon.com/users/<%= user.username %>">
      <meta name="twitter:title" content="<%= user.full_name %> (@<%= user.username %>) - Profile">
      <meta name="twitter:description" content="View the profile of <%= user.full_name %> (@<%= user.username %>) on our site.">
<meta property="og:image" content="<%= user.authorPhoto && user.switch_state === 'on' ? user.authorPhoto : user.photo %>">
<meta name="twitter:image" content="<%= user.authorPhoto && user.switch_state === 'on' ? user.authorPhoto : user.photo %>">
      <meta name="twitter:card" content="summary_large_image">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=IBM+Plex+Mono:wght@400;700&family=Space+Grotesk:wght@400;700&family=Work+Sans:wght@400;600&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
   </head>
   <body>
      <%- include('header', { currentPage: 'Member Profile' }) %> <!-- Include your header -->
       
       <style>
         .custom-border-4 {
            border-width: 4px !important;
         }
         .containerDiv ul {
            padding: 1rem;
         }
         .photo-wrap {
            position: relative;
            display: inline-block;
         }
         .profile-identity-block {
            min-height: 150px;
         }
         #location {
            min-height: 115px;
         }
         .age-pill {
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #FDF5E6;
            color: #6c757d;
            border: 2px solid currentColor;
            border-radius: 999px;
            padding: 0.1rem 0.65rem;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            white-space: nowrap;
            box-shadow: 0 0 0 3px #FDF5E6;
         }
         .rank-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            border-radius: 999px;
            border: 2px solid transparent;
            background-color: transparent;
            padding: 0.3rem 1.1rem 0.3rem 0.3rem;
            text-decoration: none;
            transition: background-color .2s ease, color .2s ease;
         }
         .rank-pill-icon {
            display: flex;
            font-size: 2.2rem;
            line-height: 1;
         }
         .rank-pill-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            text-align: left;
         }
         .rank-pill-rank {
            font-weight: 700;
            font-size: 0.9rem;
         }
         .rank-pill-score {
            font-size: 0.7rem;
            opacity: 0.85;
         }
         .rank-pill.is-live[href] {
            cursor: pointer;
         }
         .rank-pill.is-live:not([href]) {
            cursor: default !important;
            filter: brightness(0.85) !important;
            text-decoration: none !important;
         }
       </style>
      <div class="container-xxl my-md-4 bd-layout" >
         <div id="containerDiv">
            <div class="container-xxl my-md-4 bd-layout">
               <div class="row gutters-sm">
                  <div class="col-md-4 mb-3 ">
                     <div class="card">
                        <div class="card-body">
                           <div class="align-items-center text-center ">
                              <div class="photo-wrap">
                                 <img id="photo" src="https://bootdey.com/img/Content/avatar/avatar7.png" alt="Admin" class="rounded-circle border custom-border-4" width="150">
                                 <% if (user.is_anchored && user.switch_state === 'on' && user.ageBadge) { %>
                                    <span id="age-pill" class="age-pill"><%= user.ageBadge %></span>
                                 <% } %>
                              </div>
                              <div class="mt-3 ">
                                 <div class="profile-identity-block">
                                 <h4 id="fullname">John Doe</h4>
                                 <div id="badge-area" class="my-2">
                                    <% if (user.is_anchored && user.switch_state === 'on') { %>
                                       <%
                                          var cachedColor = getPhotoBorderColor(user.authorRank);
                                          var cachedTextClass = cachedColor === 'warning' ? 'text-dark' : 'text-' + cachedColor;
                                       %>
                                       <a id="rank-pill" class="rank-pill border-<%= cachedColor %> <%= cachedTextClass %>">
                                          <span class="fas fa-check-circle rank-pill-icon"></span>
                                          <span class="rank-pill-text">
                                             <span id="rank-pill-rank" class="rank-pill-rank"><%= user.authorRank %></span>
                                             <span id="rank-pill-score" class="rank-pill-score"><%= user.authorRankScore ? user.authorRankScore + ' of 5' : ' ' %></span>
                                          </span>
                                       </a>
                                    <% } else { %>
                                       <span class="rank-pill border-secondary text-muted">
                                          <span class="fas fa-check-circle rank-pill-icon"></span>
                                          <span class="rank-pill-text">
                                             <span class="rank-pill-rank">Unknown</span>
                                             <span class="rank-pill-score">Ask to verify</span>
                                          </span>
                                       </span>
                                    <% } %>
                                 </div>
                                 <p id="username" class="text-secondary mb-1">Full Stack Developer</p>
                                 </div>
                                 <p id="location" class="text-muted font-size-sm">Bay Area, San Francisco, CA</p>
                                 <% if (!isCurrentUser) { %>
                                 <div   class="pb-3 ">
                                   <button id="follow-btn" class="btn <%= isFollowing ? 'btn-primary' : 'btn-outline-primary' %>" data-username="<%= user.username %>"><%= isFollowing ? 'Following' : 'Follow' %></button>
                                   <button id="like-btn" class="btn <%= isLiked ? 'btn-danger' : 'btn-outline-danger' %>" data-username="<%= user.username %>"><span class="fas fa-heart"></span> <span id="like-count"><%= likeCount %></span></button>
                                  </div>
                                 <% } %>
                              </div>
                           </div>
                        </div>
                     </div>
                     <div id="github-badge-anchor">
                        <% if (!(user.is_anchored && user.switch_state === 'on')) { %>
                           <div class="card text-center p-3 m-3 border-warning">
                              <span class="text-warning fas fa-meh fa-10x mb-2 pt-2"></span>
                              <h5 class="card-title text-warning mb-1 pt-4">Engineering Badge Unavailable</h5>
                              <p class="card-text text-muted">No anchored identity — this member's GitHub activity can't be verified, so clients can't confirm real engineering credibility here.</p>
                           </div>
                        <% } %>
                     </div>
                  </div>
                  <div id="personal-space" class="col-md-8">
                     <div id="new-slot">
                        <% if (!(user.is_anchored && user.switch_state === 'on')) { %>
                           <% if (user.show_personal === undefined || user.show_personal !== 0) { %>
                              <div class="card mb-3">
                                 <div class="card-header text-center h5 text-secondary">Personal Details</div>
                                 <div class="card-body text-center text-muted">No personal details have been shared.</div>
                              </div>
                           <% } %>
                           <% if (user.show_contact === undefined || user.show_contact !== 0) { %>
                              <div class="card mb-3">
                                 <div class="card-header text-center h5 text-secondary">Verified Contacts</div>
                                 <div class="card-body text-center text-muted">No contacts have been shared.</div>
                              </div>
                           <% } %>
                           <% if (user.show_social === undefined || user.show_social !== 0) { %>
                              <div class="card mb-3">
                                 <div class="card-header text-center h5 text-secondary">Social Transparency</div>
                                 <div class="card-body text-center text-muted">No social profiles have been connected.</div>
                              </div>
                           <% } %>
                        <% } %>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>



      <script>
         var verifiedDetails = {};
         var containerDivOld = $('#containerDiv');
         
         
         
         function getPhotoBorderColor(authorRank) {
         switch (authorRank) {
         case 'Dangerous':
         return 'danger';
         case 'Cautioned':
         return 'warning';
         case 'Credible':
         return 'secondary';
         case 'Reliable':
         return 'success';
         case 'Genuine':
         return 'primary';
         case 'Unknown':
         return 'secondary';
         default:
         return 'secondary';
         }
         }
         
         // if a user switch_state is true
         // the author verifiedDetails.authorRank will show one of five levels
        // Dangerous, Cautioned, Credible, Reliable and Genuine
         // we want bootstrap colors danger, warning, secondary, success and primary to relate to each state
         // we want a short javascript function that returns the css class to be added to rounded-circle
         // in order to set the color of this user's photo border to their proper color


      // Select the photo element
      var photo = $('#photo');

      // Default user photo
        var defaultPhoto = '<%= user.authorPhoto && user.switch_state === "on" ? user.authorPhoto : user.photo %>';


        photo.attr('src', defaultPhoto);
         photo.attr('alt', 'Profile photo');
         photo.attr('max-width', '280');
         
         //containerDivOld.append(photo);
         
         const name = $('#fullname');
         name.text('<%= user.full_name %>');
         
         const name2 = $('#fullname2');
         name2.text('<%= user.full_name %>');
         
         const username = $('#username');
         username.text('@<%= user.username %> ');
         
         const ulocation = $('#location');
         ulocation.text('<%= user.location %>');
         
         const address2 = $('#address2');
         address2.text('<%= user.location %>');
         
         
         function filterDataConfigurations(myData, anchorType, anchorKind) {
         if (!myData || !myData.anchors) {
         return [];
         }
         var filteredData = myData.anchors.filter(function(config) {
         if (anchorType.length) {
         return config.type === anchorType && config.kind === anchorKind;
         }
         return config.kind === anchorKind;
         });
         return filteredData;
         }
      </script>

      <script>
          // Fetch processed display data
          <% 
              var displayData = getUserDisplayData(user); 
          %>

          var photo = $('#photo');

      </script>

      <% if (user.is_anchored && user.switch_state === 'on') { %>
<script>
(function() {
    var makePrivate  = !!<%= user.make_private  || 0 %>;
    var showPersonal = !!(<%- (user.show_personal === undefined || user.show_personal !== 0) ? 1 : 0 %>);
    var showContact  = !!(<%- (user.show_contact  === undefined || user.show_contact  !== 0) ? 1 : 0 %>);
    var showSocial   = !!(<%- (user.show_social   === undefined || user.show_social   !== 0) ? 1 : 0 %>);

    // Cached rank/score/age already painted the pill instantly from the DB (see SSR markup
    // above) — this just confirms it live, lights it from outline to solid, and links it.
    fetch('/users/<%= user.username %>/truanon')
        .then(function(r) { return r.ok ? r.json() : Promise.reject('unavailable'); })
        .then(function(verifiedDetails) {

            var liveColor = getPhotoBorderColor(verifiedDetails.rank);

            // === PHOTO RING === keep in sync with the live rank, not just the cached DB value
            photo.attr('class', 'rounded-circle border custom-border-4 border-' + liveColor);

            // === AGE PILL ===
            var agePill = document.getElementById('age-pill');
            if (verifiedDetails.ageBadge) {
                if (!agePill) {
                    agePill = document.createElement('span');
                    agePill.id = 'age-pill';
                    agePill.className = 'age-pill';
                    document.querySelector('.photo-wrap').appendChild(agePill);
                }
                agePill.textContent = verifiedDetails.ageBadge;
            } else if (agePill) {
                agePill.remove();
            }

            // === RANK PILL === lights up from cached outline to a solid, confirmed badge
            $('#location').text(verifiedDetails.title);

            var textClass = liveColor === 'warning' ? 'text-dark' : 'text-white';
            var rankPill = document.getElementById('rank-pill');
            rankPill.className = 'rank-pill is-live bg-' + liveColor + ' ' + textClass;
            document.getElementById('rank-pill-rank').textContent = verifiedDetails.rank;
            document.getElementById('rank-pill-score').textContent = verifiedDetails.score + ' of 5';

            if (!makePrivate) {
                var truanonConfigs = filterDataConfigurations(verifiedDetails, "truanon", "social");
                if (truanonConfigs.length) {
                    rankPill.href = "https://" + truanonConfigs[0].display;
                    rankPill.target = "_blank";
                }
            }

            // === PERSONAL / CONTACT / SOCIAL sections ===
            var truanonOnly = filterDataConfigurations(verifiedDetails, "truanon", "social");

            var filteredPersonal = filterDataConfigurations(verifiedDetails, "", "personal");
            var filteredContact  = filterDataConfigurations(verifiedDetails, "", "contact")
                .concat(filterDataConfigurations(verifiedDetails, "", "primary"));

            // fullName is kind:"contact" — pull it out and put it first in personal
            var nameEntry = filteredContact.find(function(c) { return c.type === 'fullName'; });
            if (nameEntry) {
                filteredContact  = filteredContact.filter(function(c) { return c !== nameEntry; });
                filteredPersonal = [nameEntry].concat(filteredPersonal);
            }
            var filteredSocial   = filterDataConfigurations(verifiedDetails, "", "social")
                .filter(function(c) { return !truanonOnly.includes(c); });

            var newSlot = document.getElementById("new-slot");
            newSlot.innerHTML = '';

            if (showPersonal) newSlot.appendChild(createInfoCard("Personal Details", filteredPersonal, "No personal details have been shared."));
            if (showContact)  newSlot.appendChild(createInfoCard("Verified Contacts",  filteredContact, "No contacts have been shared."));
            if (showSocial)   newSlot.appendChild(createSocialCard(filteredSocial, "No social profiles have been connected."));

            // === GITHUB BADGE (after TruAnon data is available) ===
            var githubConfig = (verifiedDetails.anchors || []).find(function(c) {
                return c.type === "github";
            });
            loadGithubBadge(githubConfig);
        })
        .catch(function(err) {
            // TruAnon is down — leave the cached pill exactly as rendered server-side,
            // it's already the member's last known rank/score, not a blank state.
            console.log('TruAnon data unavailable, showing cached badge:', err);
        });

    function loadGithubBadge(githubConfig) {
        var badgeArea = document.getElementById("github-badge-anchor");
        var icon = document.createElement("span");
        var title = document.createElement("h5");
        var description = document.createElement("p");
        var githubBadge = document.createElement("div");

        icon.className = "text-warning fas fa-ban fa-10x mb-2 pt-2";
        title.innerText = "Engineering Badge Unavailable";
        description.innerHTML = "No Validating Credentials Provided<hr><div class='text-secondary'>Trusted Sources Are: Bitbucket, GitLab, SourceForge, Codeberg, and GitHub</div>";
        githubBadge.classList.add("card", "text-center", "p-3", "m-3", "border-warning");
        title.classList.add("card-title", "text-dark", "mb-1", "pt-4");
        description.classList.add("card-text", "text-muted");
        githubBadge.append(icon, title, description);

        if (!githubConfig || githubConfig.display.startsWith("Privately Verified")) {
            badgeArea.insertAdjacentElement("afterend", githubBadge);
            return;
        }

        var loadingPlaceholder = document.createElement("div");
        loadingPlaceholder.classList.add("text-center", "p-3", "m-3", "text-muted");
        loadingPlaceholder.innerHTML = '<div><div class="fas fa-spinner fa-spin fa-2x mb-4 mt-4"></div></div>';
        badgeArea.insertAdjacentElement("afterend", loadingPlaceholder);

        fetch('/users/<%= user.username %>/github')
            .then(function(r) { if (!r.ok) throw new Error("not ok"); return r.json(); })
            .then(function(data) {
                loadingPlaceholder.remove();
                var githubUsername = data.fullName || "No Name Provided";
                var githubRepos    = data.totalRepos;
                var githubCreated  = data.githubCreated || "Unknown";
                var githubAge      = data.githubAge || "";
                var failureReasons = [];
                var badgeColor = githubRepos > 0 ? "success" : "danger";
                if (badgeColor !== "success") failureReasons.push("No Repos");
                if (githubAge.includes("0 years") && parseInt(githubAge.split(",")[1]) < 2) failureReasons.push("Not 60 Days Old");
                if (failureReasons.length) badgeColor = "danger";

                githubBadge.classList.add("text-" + badgeColor, "border-" + badgeColor);
                icon.className = "fas fa-" + (badgeColor === "success" ? "award" : "frown") + " fa-10x mb-2 pt-2";
                title.className = "card-title text-" + badgeColor + " mb-1 pt-4";
                title.innerHTML = githubUsername + "<br>" + githubRepos + " Repos";
                description.className = "card-title text-" + badgeColor + " mb-1 pt-4";
                description.innerHTML = (failureReasons.length ? "<b>Provided Credentials Do Not Suffice</b>" : "Engineer Status Validated") +
                    "<br><small class='text-muted'> " + githubCreated + " " + githubAge + "</small>";

                var allLanguages = Array.isArray(data.repos) ? data.repos.flatMap(function(r) {
                    return r.languages ? r.languages.split(", ").filter(Boolean) : [];
                }) : [];
                var uniqueLanguages = allLanguages.length ? [...new Set(allLanguages)] : ["No Computer Languages Detected"];
                var repoList = document.createElement("div");
                repoList.innerHTML = "<span class='text-muted small fst-italic'>" + uniqueLanguages.join(", ") + "</span>" +
                    "<div><br><hr><br><p>this authoritative information has been validated at the source and securely transferred to ensure trusted use</p></div>" +
                    "<div class='text-secondary'>Trusted Sources Are: Bitbucket, GitLab, SourceForge, Codeberg, and GitHub</div>";
                githubBadge.appendChild(repoList);
                badgeArea.insertAdjacentElement("afterend", githubBadge);
            })
            .catch(function(err) {
                console.error("Error fetching GitHub data:", err);
                loadingPlaceholder.innerHTML = '<div><i class="fas fa-exclamation-circle fa-4x text-danger"></i><p>Failed to load GitHub data.</p></div>';
            });
    }

    function createInfoCard(title, filteredData, emptyMessage) {
        var card = document.createElement("div");
        card.classList.add("card", "mb-3");
        var header = document.createElement("div");
        header.classList.add("card-header", "text-center", "h5", "text-secondary");
        header.innerText = title;
        card.appendChild(header);
        var cardBody = document.createElement("div");
        cardBody.classList.add("card-body");
        card.appendChild(cardBody);
        if (!filteredData.length) {
            cardBody.classList.add("text-center", "text-muted");
            cardBody.innerText = emptyMessage;
            return card;
        }
        filteredData.forEach(function(dataConfig, index) {
            var row = document.createElement("div");
            row.classList.add("row");
            cardBody.appendChild(row);
            var col1 = document.createElement("div");
            col1.classList.add("col-sm-3");
            var titleHeader = document.createElement("h6");
            titleHeader.classList.add("mb-0");
            titleHeader.innerText = dataConfig.name;
            col1.appendChild(titleHeader);
            row.appendChild(col1);
            var col2 = document.createElement("div");
            col2.classList.add("col-sm-9", "text-secondary");
            col2.innerText = dataConfig.display;
            row.appendChild(col2);
            if (index < filteredData.length - 1) cardBody.appendChild(document.createElement("hr"));
        });
        return card;
    }

    function createSocialCard(filteredData, emptyMessage) {
        var card = document.createElement("div");
        card.classList.add("card", "mb-3");
        var header = document.createElement("div");
        header.classList.add("card-header", "text-center", "h5", "text-secondary");
        header.innerText = "Social Transparency";
        card.appendChild(header);
        var display = filteredData.filter(function(c) {
            return c.type !== "github" && c.type !== "trusted";
        });
        if (!display.length) {
            var emptyBody = document.createElement("div");
            emptyBody.classList.add("card-body", "text-center", "text-muted");
            emptyBody.innerText = emptyMessage;
            card.appendChild(emptyBody);
            return card;
        }
        var grid = document.createElement("div");
        grid.classList.add("d-flex", "flex-wrap", "text-center", "p-2");
        display.forEach(function(dataConfig) {
            var item = document.createElement("div");
            item.classList.add("text-secondary", "p-2", "m-1");
            var link = document.createElement("a");
            if (makePrivate || dataConfig.display.includes("Privately")) {
                link.style.pointerEvents = "none";
                link.style.color = "gray";
            } else {
                try {
                    new URL("https://" + dataConfig.display);
                    link.href = "https://" + dataConfig.display;
                    link.target = "_blank";
                } catch(e) {
                    link.style.pointerEvents = "none";
                    link.style.color = "gray";
                }
            }
            var iconSpan = document.createElement("span");
            iconSpan.className = dataConfig.icon + " fa-5x mb-1";
            link.appendChild(iconSpan);
            var titleDiv = document.createElement("div");
            titleDiv.style.width = "92px";
            titleDiv.style.textAlign = "center";
            var titleSpan = document.createElement("div");
            titleSpan.innerText = dataConfig.name;
            titleDiv.appendChild(titleSpan);
            item.appendChild(link);
            item.appendChild(titleDiv);
            grid.appendChild(item);
        });
        card.appendChild(grid);
        return card;
    }
})();
</script>
      <% } %>


<script>
    photo.attr('src', "<%= displayData.photo %>");
    photo.attr('class', 'rounded-circle border custom-border-4 border-' + "<%= displayData.borderColor %>");
</script>

<script>
    // Simple working UI, no notifications: just toggles state and remembers each viewer's choice.
    var followBtn = document.getElementById('follow-btn');
    if (followBtn) {
        followBtn.addEventListener('click', function() {
            fetch('/users/' + followBtn.dataset.username + '/follow', { method: 'POST' })
                .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
                .then(function(result) {
                    if (!result.ok) { alert(result.data.error || 'Could not follow'); return; }
                    followBtn.textContent = result.data.following ? 'Following' : 'Follow';
                    followBtn.className = 'btn ' + (result.data.following ? 'btn-primary' : 'btn-outline-primary');
                });
        });
    }

    var likeBtn = document.getElementById('like-btn');
    if (likeBtn) {
        likeBtn.addEventListener('click', function() {
            fetch('/users/' + likeBtn.dataset.username + '/like', { method: 'POST' })
                .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
                .then(function(result) {
                    if (!result.ok) { alert(result.data.error || 'Could not like'); return; }
                    likeBtn.className = 'btn ' + (result.data.liked ? 'btn-danger' : 'btn-outline-danger');
                    document.getElementById('like-count').textContent = result.data.likeCount;
                });
        });
    }
</script>


      <%- include('footer') %>
   </body>
</html>